{# Shared table macros. Imported by every page template. #}

{% macro links_cell(links) -%}
<ul class="link-list">
  {% for link in links %}<li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a></li>{% endfor %}
</ul>
{%- endmacro %}

{% macro plan_table_grouped(groups) -%}
<div class="table-wrap table-wrap-flow">
  <table class="data-table">
    <thead>
      <tr>
        <th class="col-provider">Provider</th>
        <th>Plan</th>
        <th class="num">Price</th>
        <th>Limits</th>
        <th>Models</th>
        <th>Sources</th>
      </tr>
    </thead>
    <tbody>
      {% for group in groups %}
      {# The band spans every tr the group emits, so a note row counts too. #}
      {% set span = group.rows | length + (group.rows | selectattr("notes") | list | length) %}
      {% for row in group.rows %}
      <tr data-provider="{{ group.provider }}" style="--brand: {{ group.brand }}; --brand-ink: {{ group.ink }};">
        {% if loop.first %}
        <td class="provider-cell" rowspan="{{ span }}" id="plans-{{ group.slug }}"><span class="provider-label">{{ group.provider }}</span></td>
        {% endif %}
        <td class="cell-title">{{ row.plan }}</td>
        <td class="num" data-label="Price">
          <ul class="price-list">
            {% for entry in row | price_view %}
            <li>
              {{ entry.monthly | money(row.price_currency) }}<span class="unit">/month</span>
              {% if entry.period != "month" %}
              <span class="price-equiv">billed {{ entry.amount | money(row.price_currency) }}/{{ entry.period }}{% if entry.discount %} · save {{ entry.discount }}%{% endif %}</span>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </td>
        <td data-label="Limits">
          <ul class="cell-list">
            {% for limit in row.limits %}<li>{{ limit }}</li>{% endfor %}
          </ul>
        </td>
        <td data-label="Models">
          <ul class="cell-list">
            {% for model in row.models %}<li>{{ model }}</li>{% endfor %}
          </ul>
        </td>
        <td data-label="Sources">{{ links_cell(row.links) }}</td>
      </tr>
      {% if row.notes %}
      <tr class="note-row">
        <td colspan="5" data-label="Note"><span class="note-label">Note</span> {{ row.notes }}</td>
      </tr>
      {% endif %}
      {% endfor %}
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

{% macro api_model_table(rows) -%}
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Model</th>
        <th>Context</th>
        <th>Max output</th>
        <th class="num">Input</th>
        <th class="num">Cached input</th>
        <th class="num">Cache write</th>
        <th class="num">Output</th>
        <th class="num">Total params</th>
        <th class="num">Active params</th>
        <th>Vision</th>
        <th>Open weights</th>
        <th>Sources</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td class="cell-title">{{ row.model }}{% if row.model_id %}<br><code>{{ row.model_id }}</code>{% endif %}</td>
        <td data-label="Context">{{ row.context_window or "—" }}</td>
        <td data-label="Max output">{{ row.max_output or "—" }}</td>
        <td class="num" data-label="Input">{{ row.input | money(row.currency) }}</td>
        <td class="num" data-label="Cached input">{{ row.cached_input | money(row.currency) }}</td>
        <td class="num" data-label="Cache write">{{ row.cache_write | money(row.currency) }}</td>
        <td class="num" data-label="Output">{{ row.output | money(row.currency) }}</td>
        <td class="num" data-label="Total params">{{ row.total_params or "—" }}</td>
        <td class="num" data-label="Active params">{{ row.active_params or "—" }}</td>
        <td data-label="Vision">{% if row.vision is none %}—{% else %}{{ "yes" if row.vision else "no" }}{% endif %}</td>
        <td data-label="Open weights">{% if row.open_weights is none %}—{% else %}{{ "yes" if row.open_weights else "no" }}{% endif %}</td>
        <td data-label="Sources">{{ links_cell(row.links) }}</td>
      </tr>
      {% if row.notes %}
      <tr class="note-row">
        <td colspan="12" data-label="Note"><span class="note-label">Note</span> {{ row.notes }}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

{% macro rate_limit_table(rows) -%}
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Model</th>
        <th>Tier</th>
        <th class="num">RPM</th>
        <th class="num">Input TPM</th>
        <th class="num">Output TPM</th>
        <th class="num">Total TPM</th>
        <th class="num">RPD</th>
        <th class="num">Concurrent requests</th>
        <th>Sources</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td class="cell-title">{{ row.model }}</td>
        <td data-label="Tier">{{ row.tier }}</td>
        <td class="num" data-label="RPM">{{ row.requests_per_minute | thousands }}</td>
        <td class="num" data-label="Input TPM">{{ row.input_tokens_per_minute | thousands }}</td>
        <td class="num" data-label="Output TPM">{{ row.output_tokens_per_minute | thousands }}</td>
        <td class="num" data-label="Total TPM">{{ row.tokens_per_minute | thousands }}</td>
        <td class="num" data-label="RPD">{{ row.requests_per_day | thousands }}</td>
        <td class="num" data-label="Concurrent requests">{{ row.get("concurrent_requests") | thousands }}</td>
        <td data-label="Sources">{{ links_cell(row.links) }}</td>
      </tr>
      {% if row.notes %}
      <tr class="note-row">
        <td colspan="9" data-label="Note"><span class="note-label">Note</span> {{ row.notes }}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

{% macro provider_blocks(section, groups, table_macro) -%}
{% for group in groups %}
<div class="provider-block" id="{{ section }}-{{ group.slug }}">
  <h3 class="provider-name">{{ group.provider }}</h3>
  {{ table_macro(group.rows) }}
</div>
{% endfor %}
{%- endmacro %}
