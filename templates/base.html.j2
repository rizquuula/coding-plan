<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %} — Coding Plan Tracker</title>
<meta name="description" content="{% block description %}{% endblock %}">
<link rel="canonical" href="{{ site_url }}{{ page_href }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Coding Plan Tracker">
<meta property="og:title" content="{{ self.title() }} — Coding Plan Tracker">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:url" content="{{ site_url }}{{ page_href }}">
<meta property="og:image" content="{{ site_url }}assets/social-card.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ self.title() }} — Coding Plan Tracker">
<meta name="twitter:description" content="{{ self.description() }}">
<meta name="twitter:image" content="{{ site_url }}assets/social-card.png">
<link rel="stylesheet" href="assets/style.css">
<script>
// Apply the stored theme before first paint so the page never flashes.
(function () {
  try {
    var choice = localStorage.getItem("theme");
    if (choice === "light" || choice === "dark") {
      document.documentElement.setAttribute("data-theme", choice);
    }
  } catch (error) {
    /* Storage is blocked. Fall back to the system theme. */
  }
})();
</script>
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<div class="shell">

  <header class="sidebar">
    <div class="sidebar-bar">
      <a class="site-title" href="index.html">Coding Plan Tracker</a>
      {# Floats at the top right above 960 px. Below that it sits in this bar,
         beside the Menu button, so the two never overlap. #}
      <a class="repo-link" href="https://github.com/rizquuula/coding-plan" rel="noopener" aria-label="Open this project on GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <button id="nav-toggle" class="nav-toggle" type="button" aria-expanded="false" aria-controls="sidebar-panel">
        Menu
      </button>
    </div>

    <div id="sidebar-panel" class="sidebar-panel">
      <nav class="nav-block" aria-label="Pages">
        <p class="nav-heading">Pages</p>
        <ul class="nav-list">
          {% for page in nav.pages %}
          <li>
            <a href="{{ page.href }}"{% if page.active %} aria-current="page"{% endif %}>{{ page.label }}</a>
          </li>
          {% endfor %}
        </ul>
      </nav>

      {% if nav.anchors %}
      <nav class="nav-block" aria-labelledby="on-this-page">
        <p class="nav-heading" id="on-this-page">On this page</p>
        <ul class="nav-list nav-list-anchors">
          {% for anchor in nav.anchors %}
          <li><a href="{{ anchor.href }}">{{ anchor.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}

      <div class="nav-block theme-block">
        <p class="nav-heading" id="theme-label">Theme</p>
        <div class="theme-switch" role="group" aria-labelledby="theme-label">
          <button type="button" class="theme-button" data-theme-choice="auto" aria-pressed="true">Auto</button>
          <button type="button" class="theme-button" data-theme-choice="light" aria-pressed="false">Light</button>
          <button type="button" class="theme-button" data-theme-choice="dark" aria-pressed="false">Dark</button>
        </div>
      </div>
    </div>
  </header>

  <main id="main" class="content">

    <div class="page-header">
      <h1>{% block heading %}{% endblock %}</h1>
      <p class="lede">{% block lede %}{% endblock %}</p>
      <ul class="stats">
        {% block stats %}{% endblock %}
      </ul>
      <p class="filter-row">
        <label for="filter">Filter this page</label>
        <input id="filter" type="search" placeholder="Type a provider, plan, or model…" autocomplete="off">
      </p>
    </div>

    {% block sections %}{% endblock %}

    <footer class="page-footer">
      <p>
        Every row links to the page its values came from. Providers change prices without notice, so
        confirm a figure at its source before you act on it.
      </p>
      <p>
        Built {{ built_at }} from
        <a href="https://github.com/rizquuula/coding-plan" rel="noopener">the data files in this repository</a>.
        Structure inspired by <a href="https://jia.je/kb/en/software/coding_plan.html" rel="noopener">jia.je/kb — coding plan</a>.
      </p>
    </footer>

  </main>

</div>

<script src="assets/app.js"></script>
</body>
</html>
