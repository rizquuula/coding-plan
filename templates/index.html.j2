<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Coding Plan Tracker</title>
<meta name="description" content="Tables of AI coding subscription plans, API rates, rate limits, and model specifications.">
<link rel="stylesheet" href="assets/style.css">
</head>
<body>

<header class="page-header">
  <h1>Coding Plan Tracker</h1>
  <p class="lede">
    Subscription plans, API rates, rate limits, and model specifications for AI coding
    tools. One table per provider. Built {{ built_at }} from
    <a href="https://github.com/rizquuula/coding-plan">the data files in this repository</a>.
  </p>
  <ul class="stats">
    <li><strong>{{ counts.plans }}</strong> plans</li>
    <li><strong>{{ counts.api_pricing }}</strong> API rates</li>
    <li><strong>{{ counts.rate_limits }}</strong> rate limits</li>
    <li><strong>{{ counts.models }}</strong> models</li>
  </ul>
  <nav class="toc">
    <a href="#plans-global">Global plans</a>
    <a href="#plans-china">China plans</a>
    <a href="#api-pricing">API pricing</a>
    <a href="#rate-limits">Rate limits</a>
    <a href="#models">Model specs</a>
  </nav>
  <p class="filter-row">
    <label for="filter">Filter all tables</label>
    <input id="filter" type="search" placeholder="Type a provider, plan, or model…" autocomplete="off">
  </p>
</header>

{% macro links_cell(links) -%}
<ul class="link-list">
  {% for link in links %}<li><a href="{{ link.url }}" rel="noopener">{{ link.label }}</a></li>{% endfor %}
</ul>
{%- endmacro %}

{% macro plan_table(rows) -%}
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Plan</th>
        <th class="num">Price</th>
        <th>Limits</th>
        <th>Models</th>
        <th>Sources</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td>{{ row.plan }}</td>
        <td class="num">
          <ul class="price-list">
            {% for entry in row | price_view %}
            <li>
              {{ entry.amount | money(row.price_currency) }}<span class="unit">/{{ entry.period }}</span>
              {% if entry.period != "month" %}
              <span class="price-equiv">{{ entry.monthly | money(row.price_currency) }}/mo{% if entry.discount %} · save {{ entry.discount }}%{% endif %}</span>
              {% endif %}
            </li>
            {% endfor %}
          </ul>
        </td>
        <td>
          <ul class="cell-list">
            {% for limit in row.limits %}<li>{{ limit }}</li>{% endfor %}
          </ul>
        </td>
        <td>
          <ul class="cell-list">
            {% for model in row.models %}<li>{{ model }}</li>{% endfor %}
          </ul>
        </td>
        <td>{{ links_cell(row.links) }}</td>
      </tr>
      {% if row.notes %}
      <tr class="note-row">
        <td colspan="5"><span class="note-label">Note</span> {{ row.notes }}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

{% macro api_table(rows) -%}
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Model</th>
        <th>Context</th>
        <th class="num">Input</th>
        <th class="num">Cached input</th>
        <th class="num">Cache write</th>
        <th class="num">Output</th>
        <th>Sources</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td>{{ row.model }}{% if row.model_id %}<br><code>{{ row.model_id }}</code>{% endif %}</td>
        <td>{{ row.context_window or "—" }}</td>
        <td class="num">{{ row.input | money(row.currency) }}</td>
        <td class="num">{{ row.cached_input | money(row.currency) }}</td>
        <td class="num">{{ row.cache_write | money(row.currency) }}</td>
        <td class="num">{{ row.output | money(row.currency) }}</td>
        <td>{{ links_cell(row.links) }}</td>
      </tr>
      {% if row.notes %}
      <tr class="note-row">
        <td colspan="7"><span class="note-label">Note</span> {{ row.notes }}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

{% macro rate_limit_table(rows) -%}
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Model</th>
        <th>Tier</th>
        <th class="num">RPM</th>
        <th class="num">Input TPM</th>
        <th class="num">Output TPM</th>
        <th class="num">Total TPM</th>
        <th class="num">RPD</th>
        <th>Sources</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td>{{ row.model }}</td>
        <td>{{ row.tier }}</td>
        <td class="num">{{ row.requests_per_minute | thousands }}</td>
        <td class="num">{{ row.input_tokens_per_minute | thousands }}</td>
        <td class="num">{{ row.output_tokens_per_minute | thousands }}</td>
        <td class="num">{{ row.tokens_per_minute | thousands }}</td>
        <td class="num">{{ row.requests_per_day | thousands }}</td>
        <td>{{ links_cell(row.links) }}</td>
      </tr>
      {% if row.notes %}
      <tr class="note-row">
        <td colspan="8"><span class="note-label">Note</span> {{ row.notes }}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

{% macro model_table(rows) -%}
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Model</th>
        <th class="num">Total params</th>
        <th class="num">Active params</th>
        <th>Context</th>
        <th>Max output</th>
        <th>Vision</th>
        <th>Open weights</th>
        <th>Sources</th>
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        <td>{{ row.name }}</td>
        <td class="num">{{ row.total_params or "—" }}</td>
        <td class="num">{{ row.active_params or "—" }}</td>
        <td>{{ row.context_window or "—" }}</td>
        <td>{{ row.max_output or "—" }}</td>
        <td>{{ "yes" if row.vision else "no" }}</td>
        <td>{{ "yes" if row.open_weights else "no" }}</td>
        <td>{{ links_cell(row.links) }}</td>
      </tr>
      {% if row.notes %}
      <tr class="note-row">
        <td colspan="8"><span class="note-label">Note</span> {{ row.notes }}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>
{%- endmacro %}

{% macro provider_blocks(section, groups, table_macro) -%}
{% for group in groups %}
<div class="provider-block" id="{{ section }}-{{ group.slug }}">
  <h3 class="provider-name">{{ group.provider }}</h3>
  {{ table_macro(group.rows) }}
</div>
{% endfor %}
{%- endmacro %}

<main>

<section id="plans-global">
  <h2>Global coding plans</h2>
  <p class="section-note">Subscription tiers that include an AI coding tool. Prices are the list price for one seat. A tier that discounts a longer billing term lists every term, with the monthly equivalent and the saving.</p>
  {{ provider_blocks("plans-global", plans_global, plan_table) }}
</section>

<section id="plans-china">
  <h2>China provider plans</h2>
  <p class="section-note">Plans from Chinese model providers. Prices are the ones the provider lists on its international site.</p>
  {{ provider_blocks("plans-china", plans_china, plan_table) }}
</section>

<section id="api-pricing">
  <h2>API pricing</h2>
  <p class="section-note">Rates per 1M tokens. Cache write is the 5-minute TTL rate. A dash means the provider does not publish a separate rate.</p>
  {{ provider_blocks("api-pricing", api_pricing, api_table) }}
</section>

<section id="rate-limits">
  <h2>Rate limits</h2>
  <p class="section-note">Published API rate limits per usage tier. RPM is requests per minute, TPM is tokens per minute, RPD is requests per day. A dash means the provider does not publish that number.</p>
  {{ provider_blocks("rate-limits", rate_limits, rate_limit_table) }}
</section>

<section id="models">
  <h2>Model specifications</h2>
  <p class="section-note">Only models whose vendor publishes a specification page. Vendors that do not publish parameter counts leave those cells as a dash.</p>
  {{ provider_blocks("models", models, model_table) }}
</section>

</main>

<footer class="page-footer">
  <p>
    Every row links to the page its values came from. Providers change prices without notice, so
    confirm a figure at its source before you act on it.
  </p>
  <p>Structure inspired by <a href="https://jia.je/kb/en/software/coding_plan.html" rel="noopener">jia.je/kb — coding plan</a>.</p>
</footer>

<script src="assets/app.js"></script>
</body>
</html>
