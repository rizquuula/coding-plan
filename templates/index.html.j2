{% extends "base.html.j2" %}
{% from "macros.html.j2" import plan_table_grouped %}

{% block title %}Coding Plans{% endblock %}
{% block description %}One table of AI coding subscription plans, grouped by provider.{% endblock %}
{% block heading %}Coding Plans{% endblock %}
{% block lede %}Subscription plans that include an AI coding tool. One table, grouped by provider.{% endblock %}

{% block stats %}
<li><strong>{{ counts.plans }}</strong> plans</li>
{% endblock %}

{% block sections %}
<section id="plans">
  <h2>Coding plans</h2>
  <p class="section-note">Subscription tiers that include an AI coding tool. Prices are the list price for one seat. A tier that discounts a longer billing term lists every term, with the monthly equivalent and the saving.</p>
  {{ plan_table_grouped(plans_all) }}
</section>
{% endblock %}
